<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon foreground (ANDROID.md §8 T11).

  A white thermometer with a green mercury column in the overlay palette, drawn
  on the 108dp adaptive canvas. All art sits inside the 66dp safe circle, so
  circular, squircle and rounded-square launcher masks cannot crop the bulb.
  The background layer supplies Palette.dark (#090D13).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Outer body: rounded stem joined to the bulb in one filled silhouette. -->
    <path
        android:fillColor="#FFF5F8FC"
        android:pathData="M48,61.47 L48,31 a6,6 0 0 1 12,0 L60,61.47 A13,13 0 1 1 48,61.47 Z" />
    <!-- Mercury bulb, inset from the white rim. -->
    <path
        android:fillColor="#FF2EA043"
        android:pathData="M54,73 m-9,0 a9,9 0 1 1 18,0 a9,9 0 1 1 -18,0" />
    <!-- Mercury column rising from the bulb. -->
    <path
        android:strokeColor="#FF2EA043"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M54,73 L54,43" />
</vector>
